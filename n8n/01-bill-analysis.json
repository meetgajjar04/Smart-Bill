{
  "name": "Smart Bill AI - Bill Analysis",
  "nodes": [
    {
      "parameters": {
        "content": "**Smart Bill AI – Bill analysis**\n\nTriggered by the backend after a user confirms a bill.\n1. Verify shared secret\n2. Pull ML analysis (anomaly, forecast, tips)\n3. Decide + write messages\n4. Save result, raise in-app alert, e-mail if enabled\n\nEnv needed: BACKEND_URL, INTERNAL_API_KEY, N8N_WEBHOOK_SECRET, SMTP_FROM",
        "width": 440,
        "height": 230
      },
      "id": "note--200",
      "name": "Note -200",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -40
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "bill-analysis",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook",
      "name": "Bill Confirmed Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        300,
        300
      ],
      "webhookId": "smartbill-bill-analysis"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "secret-valid?",
              "leftValue": "={{ $json.headers['x-webhook-secret'] }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "={{ $env.N8N_WEBHOOK_SECRET }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "secret-valid?",
      "name": "Secret Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/internal/bills/{{ $('Bill Confirmed Webhook').item.json.body.bill_id }}/analysis",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        }
      },
      "id": "fetch-ml-analysis",
      "name": "Fetch ML Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Turns the ML output from the backend into a decision + human-readable messages.\nconst a = $input.first().json;\nconst b = a.bill, an = a.anomaly, f = a.forecast, u = a.user, ur = a.unit_rate;\nconst esc = s => String(s ?? '').replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst inr = n => '₹' + Number(n).toLocaleString('en-IN', {maximumFractionDigits: 0});\nconst cat = b.category.charAt(0).toUpperCase() + b.category.slice(1);\n\nlet summary = `${cat} bill of ${inr(b.amount)} looks normal.`;\nif (an.is_anomaly) {\n  summary = `${cat} bill of ${inr(b.amount)} is unusually high: ${an.reason}`;\n  if (ur && ur.avg_previous) {\n    const d = (ur.current / ur.avg_previous - 1) * 100;\n    summary += Math.abs(d) < 8 ? ' The per-unit rate is unchanged, so usage went up.'\n                               : ` The per-unit rate also moved ${d > 0 ? '+' : ''}${d.toFixed(0)}% — check for a tariff change.`;\n  }\n}\nconst dueSoon = b.days_to_due !== null && b.days_to_due <= 3 && b.state !== 'paid';\nif (dueSoon) summary += b.days_to_due < 0 ? ' It is overdue.' : ` It is due in ${b.days_to_due} day(s).`;\n\nconst tip = (a.recommendations[0] || {}).title || null;\nconst needsAttention = an.is_anomaly || dueSoon;\nconst severity = an.severity !== 'none' ? an.severity : (dueSoon ? 'medium' : 'none');\n\nconst html = `<div style=\"font-family:system-ui,sans-serif;max-width:520px\">\n<h2 style=\"margin:0 0 8px\">Heads-up about your ${esc(cat)} bill</h2>\n<p>Hi ${esc(u.name)},</p><p>${esc(summary)}</p>\n${f ? `<p>Next month's forecast: <b>${inr(f.amount)}</b> (range ${inr(f.low)}–${inr(f.high)}).</p>` : ''}\n${tip ? `<p><b>Suggestion:</b> ${esc(tip)}</p>` : ''}\n<p style=\"color:#666;font-size:12px\">Sent by Smart Bill AI</p></div>`;\n\nreturn [{ json: {\n  bill_id: b.id, user_id: b.user_id, email: u.email, notify_email: u.notify_email,\n  is_anomaly: an.is_anomaly, severity, needs_attention: needsAttention,\n  summary: summary.slice(0, 500), forecast_next: f ? f.amount : null, top_tip: tip,\n  alert_severity: severity === 'high' ? 'critical' : 'warning',\n  subject: `Smart Bill AI: ${cat} bill needs your attention`, html,\n}}];"
      },
      "id": "build-verdict",
      "name": "Build Verdict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/bills/{{ $('Build Verdict').item.json.bill_id }}/analysis-result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ is_anomaly: $('Build Verdict').item.json.is_anomaly, severity: $('Build Verdict').item.json.severity, summary: $('Build Verdict').item.json.summary, forecast_next: $('Build Verdict').item.json.forecast_next, top_tip: $('Build Verdict').item.json.top_tip, source: 'n8n' }) }}"
      },
      "id": "save-analysis",
      "name": "Save Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1240,
        280
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "needs-attention?",
              "leftValue": "={{ $('Build Verdict').item.json.needs_attention }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "needs-attention?",
      "name": "Needs Attention?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1480,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_URL }}/api/internal/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ user_id: $('Build Verdict').item.json.user_id, bill_id: $('Build Verdict').item.json.bill_id, kind: $('Build Verdict').item.json.is_anomaly ? 'anomaly' : 'reminder', severity: $('Build Verdict').item.json.alert_severity, message: $('Build Verdict').item.json.summary }) }}"
      },
      "id": "create-in-app-alert",
      "name": "Create In-App Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1720,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e-mail-enabled?",
              "leftValue": "={{ $('Build Verdict').item.json.notify_email }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e-mail-enabled?",
      "name": "E-mail Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1960,
        220
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.SMTP_FROM }}",
        "toEmail": "={{ $('Build Verdict').item.json.email }}",
        "subject": "={{ $('Build Verdict').item.json.subject }}",
        "emailFormat": "html",
        "html": "={{ $('Build Verdict').item.json.html }}",
        "options": {}
      },
      "id": "send-alert-e-mail",
      "name": "Send Alert E-mail",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        2200,
        200
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "smtp": {
          "id": "REPLACE_ME",
          "name": "SMTP (configure in n8n)"
        }
      }
    }
  ],
