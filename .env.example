# Copy to .env and replace EVERY value marked change-me / CHANGE_ME.
# Generate each secret separately with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never ship the resulting .env with the project. .env.example is the only template.

# --- Mode -------------------------------------------------------------------
# development (default) or production. Production refuses weak secrets, HTTP-only
# cookies, SQLite and unencrypted SMTP at startup.
APP_ENV=development
COOKIE_SECURE=false                 # must be true when served over HTTPS
TRUST_PROXY_HEADERS=false           # true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUSTED_PROXY_HOPS=1                # app-facing trusted hops; X-Forwarded-For is read from the RIGHT
ACCESS_TOKEN_MINUTES=15             # short-lived; the DB checks token_version on every request
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Secrets (must all be different random values) --------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_PASSWORD=change-me-database-password
SECRET_KEY=change-me-jwt-signing-key-at-least-32-characters
# JWTs pin issuer/audience and carry a key id. To rotate SECRET_KEY, put the old
# value here (comma-separated for several), deploy, then remove it after the
# access-token lifetime. It must also be a random value of at least 32 characters.
JWT_ISSUER=smartbill-ai
JWT_AUDIENCE=smartbill-web
JWT_KEY_ID=primary
JWT_PREVIOUS_SECRET_KEYS=
RATE_LIMIT_SECRET=change-me-rate-limit-secret-at-least-32-characters
INTERNAL_API_KEY=change-me-internal-api-key-at-least-24-characters
N8N_WEBHOOK_SECRET=change-me-webhook-secret-at-least-24-characters
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-at-least-32-characters

# --- Database ---------------------------------------------------------------
# Docker Compose uses this URL shape with the MYSQL_PASSWORD above.
# For the local XAMPP setup, run: cd backend && python -m scripts.setup_mysql
# then paste the URL it prints (store it in your secret manager, not in docs).
DATABASE_URL=mysql+pymysql://smartbill:change-me-database-password@127.0.0.1:3306/smartbill
# DATABASE_URL=sqlite:///./smartbill.db   # tests / zero-setup demo only

# --- E-mail: deadline reminders + unusual-bill alerts -----------------------
# Leave SMTP_HOST blank for in-app alerts only. In production the connection
# must be encrypted (SMTP_STARTTLS=true or SMTP_SSL=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Smart Bill AI <alerts@example.com>
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_ENABLED=true
REMINDER_DAYS_BEFORE=1

# --- OCR (local Tesseract + Poppler install) --------------------------------
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
# TESSDATA_PREFIX=C:/Program Files/Tesseract-OCR/tessdata
# POPPLER_PATH=C:/path/to/poppler/Library/bin
OCR_LANG=eng

# --- AI (local Ollama; blank model = first installed model) -----------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_ANALYSIS_MODEL=
OLLAMA_ENABLED=true
OLLAMA_EXTRACT=true
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_THREAD=0
OLLAMA_KEEP_ALIVE=30m
OLLAMA_WARMUP=true

# --- Optional n8n orchestration ---------------------------------------------
# Blank URL = use the built-in local pipeline. Compose enables n8n only with
# --profile n8n; import and activate both workflows in n8n/ before use.
# Compose keeps N8N_BLOCK_ENV_ACCESS_IN_NODE=false because the bundled Code nodes
# read shared secrets from $env. In production prefer true plus n8n credentials.
N8N_WEBHOOK_URL=
